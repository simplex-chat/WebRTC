+#import "api/peerconnection/RTCPeerConnection.h"
+#import "api/peerconnection/RTCPeerConnectionFactory.h"
+#import "api/peerconnection/RTCRtpReceiver+Private.h"
+#import "api/peerconnection/RTCRtpSender+Private.h"
+#import "api/peerconnection/RTCRtpTransceiver.h"
+
+typedef NSData *_Nullable (^RTCFrameTransform)(NSData *frame);
+
+@interface RTCFrameTransformDelegate
+    : NSObject <RTC_OBJC_TYPE (RTCFrameEncryptorDelegate),
+                RTC_OBJC_TYPE (RTCFrameDecryptorDelegate)>
+@property(nonatomic, copy) RTCFrameTransform transform;
+@property(nonatomic, readonly) RTCRtpMediaType lastMediaType;
+@property(nonatomic, readonly) const void *lastFrameBytes;
+
+- (instancetype)initWithTransform:(RTCFrameTransform)transform;
+
+@end
+
+@implementation RTCFrameTransformDelegate
+
+@synthesize transform = _transform;
+@synthesize lastMediaType = _lastMediaType;
+@synthesize lastFrameBytes = _lastFrameBytes;
+
+- (instancetype)initWithTransform:(RTCFrameTransform)transform {
+  self = [super init];
+  if (self) {
+    _transform = transform;
+    _lastMediaType = RTCRtpMediaTypeUnsupported;
+  }
+  return self;
+}
+
+- (nullable NSData *)frameEncryptor:
+                         (RTC_OBJC_TYPE(RTCFrameEncryptor) *)encryptor
+                          mediaType:(RTCRtpMediaType)mediaType
+                          withFrame:(NSData *)unencrypted {
+  return [self record:mediaType frame:unencrypted];
+}
+
+- (nullable NSData *)frameDecryptor:
+                         (RTC_OBJC_TYPE(RTCFrameDecryptor) *)decryptor
+                          mediaType:(RTCRtpMediaType)mediaType
+                          withFrame:(NSData *)encrypted {
+  return [self record:mediaType frame:encrypted];
+}
+
+- (nullable NSData *)record:(RTCRtpMediaType)mediaType frame:(NSData *)frame {
+  _lastMediaType = mediaType;
+  _lastFrameBytes = frame.bytes;
+  return _transform(frame);
+}
+
+@end
+
+static RTCFrameTransform AppendBytes(NSUInteger count, uint8_t value) {
+  return ^NSData *(NSData *frame) {
+    NSMutableData *result = [frame mutableCopy];
+    std::vector<uint8_t> tail(count, value);
+    [result appendBytes:tail.data() length:tail.size()];
+    return result;
+  };
+}
+
+static RTCFrameTransform DropLastBytes(NSUInteger count) {
+  return ^NSData *(NSData *frame) {
+    return [frame subdataWithRange:NSMakeRange(0, frame.length - count)];
+  };
+}
+
+static constexpr uint8_t kFillByte = 0xAA;
+static constexpr size_t kUnwritten = 12345;
+
+@interface RTCFrameEncryptionTest : XCTestCase
+@end
+
+@implementation RTCFrameEncryptionTest
+
+- (void)testEncryptCopiesDelegateOutputIntoBuffer {
+  RTCFrameTransformDelegate *delegate = [[RTCFrameTransformDelegate alloc]
+      initWithTransform:AppendBytes(4, kFillByte)];
+  RTC_OBJC_TYPE(RTCFrameEncryptor) *encryptor =
+      [[RTC_OBJC_TYPE(RTCFrameEncryptor) alloc] initWithSizeChange:4];
+  encryptor.delegate = delegate;
+  webrtc::scoped_refptr<webrtc::FrameEncryptorInterface> native =
+      encryptor.nativeFrameEncryptor;
+
+  const std::vector<uint8_t> frame = {1, 2, 3};
+  std::vector<uint8_t> output(
+      native->GetMaxCiphertextByteSize(webrtc::MediaType::AUDIO, frame.size()));
+  size_t written = kUnwritten;
+  int status =
+      native->Encrypt(webrtc::MediaType::AUDIO, 0, {}, frame, output, &written);
+
+  XCTAssertEqual(status, 0);
+  XCTAssertEqual(written, 7u);
+  XCTAssertTrue((output ==
+                 std::vector<uint8_t>{
+                     1, 2, 3, kFillByte, kFillByte, kFillByte, kFillByte}));
+  XCTAssertEqual(delegate.lastMediaType, RTCRtpMediaTypeAudio);
+  XCTAssertTrue(delegate.lastFrameBytes == frame.data(),
+                @"Delegate should receive WebRTC's buffer without a copy");
+}
+
+- (void)testEncryptRejectsOutputLargerThanBuffer {
+  RTCFrameTransformDelegate *delegate = [[RTCFrameTransformDelegate alloc]
+      initWithTransform:AppendBytes(8, kFillByte)];
+  RTC_OBJC_TYPE(RTCFrameEncryptor) *encryptor =
+      [[RTC_OBJC_TYPE(RTCFrameEncryptor) alloc] initWithSizeChange:4];
+  encryptor.delegate = delegate;
+  webrtc::scoped_refptr<webrtc::FrameEncryptorInterface> native =
+      encryptor.nativeFrameEncryptor;
+
+  const std::vector<uint8_t> frame = {1, 2, 3};
+  std::vector<uint8_t> output(
+      native->GetMaxCiphertextByteSize(webrtc::MediaType::AUDIO, frame.size()));
+  size_t written = kUnwritten;
+  int status =
+      native->Encrypt(webrtc::MediaType::AUDIO, 0, {}, frame, output, &written);
+
+  XCTAssertEqual(status, webrtc::RTCFrameEncryptorAdapter::kEncryptionFailed);
+  XCTAssertEqual(written, kUnwritten);
+  XCTAssertTrue((output == std::vector<uint8_t>(7, 0)),
+                @"Buffer must stay untouched when output does not fit");
+}
+
+- (void)testEncryptFailsWithoutDelegate {
+  RTC_OBJC_TYPE(RTCFrameEncryptor) *encryptor =
+      [[RTC_OBJC_TYPE(RTCFrameEncryptor) alloc] initWithSizeChange:4];
+  webrtc::scoped_refptr<webrtc::FrameEncryptorInterface> native =
+      encryptor.nativeFrameEncryptor;
+
+  const std::vector<uint8_t> frame = {1, 2, 3};
+  std::vector<uint8_t> output(7);
+  size_t written = kUnwritten;
+  int status =
+      native->Encrypt(webrtc::MediaType::VIDEO, 0, {}, frame, output, &written);
+
+  XCTAssertEqual(status, webrtc::RTCFrameEncryptorAdapter::kEncryptionFailed);
+  XCTAssertEqual(written, kUnwritten);
+}
+
+- (void)testEncryptFailsAfterEncryptorIsReleased {
+  RTCFrameTransformDelegate *delegate = [[RTCFrameTransformDelegate alloc]
+      initWithTransform:AppendBytes(4, kFillByte)];
+  webrtc::scoped_refptr<webrtc::FrameEncryptorInterface> native;
+  @autoreleasepool {
+    RTC_OBJC_TYPE(RTCFrameEncryptor) *encryptor =
+        [[RTC_OBJC_TYPE(RTCFrameEncryptor) alloc] initWithSizeChange:4];
+    encryptor.delegate = delegate;
+    native = encryptor.nativeFrameEncryptor;
+  }
+
+  const std::vector<uint8_t> frame = {1, 2, 3};
+  std::vector<uint8_t> output(7);
+  size_t written = kUnwritten;
+  int status =
+      native->Encrypt(webrtc::MediaType::AUDIO, 0, {}, frame, output, &written);
+
+  XCTAssertEqual(status,
+                 webrtc::RTCFrameEncryptorAdapter::kEncryptionFailed,
+                 @"A sender may keep the adapter after the encryptor is gone");
+  XCTAssertTrue(delegate.lastFrameBytes == nullptr,
+                @"Delegate must not be called once the encryptor is gone");
+}
+
+- (void)testDecryptCopiesDelegateOutputIntoBuffer {
+  RTCFrameTransformDelegate *delegate =
+      [[RTCFrameTransformDelegate alloc] initWithTransform:DropLastBytes(2)];
+  RTC_OBJC_TYPE(RTCFrameDecryptor) *decryptor =
+      [[RTC_OBJC_TYPE(RTCFrameDecryptor) alloc] initWithSizeChange:0];
+  decryptor.delegate = delegate;
+  webrtc::scoped_refptr<webrtc::FrameDecryptorInterface> native =
+      decryptor.nativeFrameDecryptor;
+
+  const std::vector<uint8_t> encrypted = {1, 2, 3, 4, 5};
+  std::vector<uint8_t> output(native->GetMaxPlaintextByteSize(
+      webrtc::MediaType::VIDEO, encrypted.size()));
+  webrtc::FrameDecryptorInterface::Result result =
+      native->Decrypt(webrtc::MediaType::VIDEO, {}, {}, encrypted, output);
+
+  XCTAssertTrue(result.IsOk());
+  XCTAssertEqual(result.bytes_written, 3u);
+  XCTAssertTrue((output == std::vector<uint8_t>{1, 2, 3, 0, 0}));
+  XCTAssertEqual(delegate.lastMediaType, RTCRtpMediaTypeVideo);
+  XCTAssertTrue(delegate.lastFrameBytes == encrypted.data(),
+                @"Delegate should receive WebRTC's buffer without a copy");
+}
+
+- (void)testDecryptRejectsOutputLargerThanBuffer {
+  RTCFrameTransformDelegate *delegate = [[RTCFrameTransformDelegate alloc]
+      initWithTransform:AppendBytes(1, kFillByte)];
+  RTC_OBJC_TYPE(RTCFrameDecryptor) *decryptor =
+      [[RTC_OBJC_TYPE(RTCFrameDecryptor) alloc] initWithSizeChange:0];
+  decryptor.delegate = delegate;
+  webrtc::scoped_refptr<webrtc::FrameDecryptorInterface> native =
+      decryptor.nativeFrameDecryptor;
+
+  const std::vector<uint8_t> encrypted = {1, 2, 3};
+  std::vector<uint8_t> output(native->GetMaxPlaintextByteSize(
+      webrtc::MediaType::AUDIO, encrypted.size()));
+  webrtc::FrameDecryptorInterface::Result result =
+      native->Decrypt(webrtc::MediaType::AUDIO, {}, {}, encrypted, output);
+
+  XCTAssertEqual(result.status,
+                 webrtc::FrameDecryptorInterface::Status::kFailedToDecrypt);
+  XCTAssertEqual(result.bytes_written, 0u);
+  XCTAssertTrue((output == std::vector<uint8_t>(3, 0)),
+                @"Buffer must stay untouched when output does not fit");
+}
+
+- (void)testDecryptFailsWithoutDelegate {
+  RTC_OBJC_TYPE(RTCFrameDecryptor) *decryptor =
+      [[RTC_OBJC_TYPE(RTCFrameDecryptor) alloc] initWithSizeChange:0];
+  webrtc::scoped_refptr<webrtc::FrameDecryptorInterface> native =
+      decryptor.nativeFrameDecryptor;
+
+  const std::vector<uint8_t> encrypted = {1, 2, 3};
+  std::vector<uint8_t> output(3);
+  webrtc::FrameDecryptorInterface::Result result =
+      native->Decrypt(webrtc::MediaType::AUDIO, {}, {}, encrypted, output);
+
+  XCTAssertEqual(result.status,
+                 webrtc::FrameDecryptorInterface::Status::kFailedToDecrypt);
+}
+
+- (void)testMaxSizeAppliesSizeChangeAndClampsAtZero {
+  RTC_OBJC_TYPE(RTCFrameEncryptor) *growing =
+      [[RTC_OBJC_TYPE(RTCFrameEncryptor) alloc] initWithSizeChange:28];
+  RTC_OBJC_TYPE(RTCFrameDecryptor) *shrinking =
+      [[RTC_OBJC_TYPE(RTCFrameDecryptor) alloc] initWithSizeChange:-28];
+
+  XCTAssertEqual(growing.nativeFrameEncryptor->GetMaxCiphertextByteSize(
+                     webrtc::MediaType::VIDEO, 100),
+                 128u);
+  XCTAssertEqual(shrinking.nativeFrameDecryptor->GetMaxPlaintextByteSize(
+                     webrtc::MediaType::VIDEO, 100),
+                 72u);
+  XCTAssertEqual(shrinking.nativeFrameDecryptor->GetMaxPlaintextByteSize(
+                     webrtc::MediaType::VIDEO, 10),
+                 0u,
+                 @"A negative size change must not wrap around");
+}
+
+- (void)testSetRtcFrameCryptorsAttachToNativeSenderAndReceiver {
+  RTC_OBJC_TYPE(RTCConfiguration) *config =
+      [[RTC_OBJC_TYPE(RTCConfiguration) alloc] init];
+  config.sdpSemantics = RTCSdpSemanticsUnifiedPlan;
+  RTC_OBJC_TYPE(RTCMediaConstraints) *constraints =
+      [[RTC_OBJC_TYPE(RTCMediaConstraints) alloc]
+          initWithMandatoryConstraints:@{}
+                   optionalConstraints:nil];
+  RTC_OBJC_TYPE(RTCRtpTransceiverInit) *init =
+      [[RTC_OBJC_TYPE(RTCRtpTransceiverInit) alloc] init];
+  RTC_OBJC_TYPE(RTCFrameEncryptor) *encryptor =
+      [[RTC_OBJC_TYPE(RTCFrameEncryptor) alloc] initWithSizeChange:28];
+  RTC_OBJC_TYPE(RTCFrameDecryptor) *decryptor =
+      [[RTC_OBJC_TYPE(RTCFrameDecryptor) alloc] initWithSizeChange:0];
+
+  @autoreleasepool {
+    RTC_OBJC_TYPE(RTCPeerConnectionFactory) *factory =
+        [[RTC_OBJC_TYPE(RTCPeerConnectionFactory) alloc] init];
+    RTC_OBJC_TYPE(RTCPeerConnection) *peerConnection =
+        [factory peerConnectionWithConfiguration:config
+                                     constraints:constraints
+                                        delegate:nil];
+    RTC_OBJC_TYPE(RTCRtpTransceiver) *transceiver =
+        [peerConnection addTransceiverOfType:RTCRtpMediaTypeVideo init:init];
+    XCTAssertNotNil(transceiver);
+
+    [transceiver.sender setRtcFrameEncryptor:encryptor];
+    [transceiver.receiver setRtcFrameDecryptor:decryptor];
+
+    XCTAssertTrue(transceiver.sender.nativeRtpSender->GetFrameEncryptor() ==
+                  encryptor.nativeFrameEncryptor);
+    XCTAssertTrue(transceiver.receiver.nativeRtpReceiver->GetFrameDecryptor() ==
+                  decryptor.nativeFrameDecryptor);
+
+    [peerConnection close];
+  }
+}
+
+@end
